# DeSinaHub — environment template
# Copy to .env.local for local work, or set the same keys in the hosting project.
# Never commit real values. Keys used only by the server (api/, lib/, workers/)
# must never be exposed with a NEXT_PUBLIC_ prefix.

# ── Site ───────────────────────────────────────────────────────────────
# Absolute origin used for metadata, canonical URLs, JSON-LD and sitemap entries.
NEXT_PUBLIC_SITE_URL=https://www.desinahub.com

# ── MongoDB Atlas (orders, webhook events, jobs) ───────────────────────
MONGODB_URI=
MONGODB_DATABASE=DeSinaHubDB
MONGODB_ORDERS_COLLECTION=orders
MONGODB_WEBHOOK_COLLECTION=webhook_events
MONGODB_JOBS_COLLECTION=jobs
MONGODB_DLQ_COLLECTION=dead_letter_jobs

# ── AI assistant (api/chat.js) ─────────────────────────────────────────
# Left empty on purpose: without a key the route answers 503 and the widget
# keeps its built-in bilingual local answers. Nothing breaks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=60000

# ── Order tracking (api/track.js) ──────────────────────────────────────
TRACK_RATE_LIMIT_MAX=8
TRACK_RATE_LIMIT_WINDOW_MS=60000

# ── Checkout (api/checkout.js) ─────────────────────────────────────────
CHECKOUT_RATE_LIMIT_MAX=10
CHECKOUT_RATE_LIMIT_WINDOW_MS=600000

# ── Payment gateways ───────────────────────────────────────────────────
# Local tests must run against sandbox endpoints; never charge real cards.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Unset means the live endpoint https://api-m.paypal.com — point it at
# https://api-m.sandbox.paypal.com while testing.
PAYPAL_API_BASE=
PAYMOB_WEBHOOK_SECRET=
FAWRY_WEBHOOK_SECRET=
BANK_WEBHOOK_SECRET=
# Shared secret for gateway → api/webhook*.js callbacks.
WEBHOOK_SECRET=
# Set to "true" ONLY for a controlled local test without a signable gateway.
# Leaving it unset keeps signature verification mandatory (the safe default).
WEBHOOK_ALLOW_UNVERIFIED=

# ── Supabase backup webhook (api/webhook-supabase.js) ──────────────────
# Server-side only. The service-role key must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Table name; defaults to webhook_events when unset.
SUPABASE_WEBHOOK_TABLE=

# ── Background worker (workers/paymentworker.js, /api/worker cron) ─────
CRON_SECRET=
WORKER_ID=
WORKER_BATCH_SIZE=5
WORKER_CONCURRENCY=5
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=8
WORKER_POLL_INTERVAL_MS=1500
WORKER_RETRY_BASE_MS=5000
WORKER_RETRY_MAX_MS=900000
JOB_BATCH_SIZE=25
JOB_LEASE_SECONDS=300
MAX_JOB_ATTEMPTS=8

# ── Notifications ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CUSTOMER_EMAIL_WEBHOOK_URL=
CUSTOMER_EMAIL_API_KEY=

# ── Marketing / CRM conversions (all optional; each call is skipped when
#    its own variables are missing) ─────────────────────────────────────
GA_MEASUREMENT_ID=
GA_API_SECRET=
FB_PIXEL_ID=
FB_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
MIXPANEL_TOKEN=
HUBSPOT_API_KEY=
HUBSPOT_PIPELINE=
HUBSPOT_CLOSED_WON_STAGE=
HUBSPOT_OWNER_ID=
SALESFORCE_LOGIN_URL=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
