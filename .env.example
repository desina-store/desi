# ─── Public ────────────────────────────────────────────────────────────────
# Canonical URL used by metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.desinahub.com

# ─── Database (required for checkout, chatv and webhooks) ───────────────────
MONGODB_URI=
MONGODB_DATABASE=DeSinaHubDB
MONGODB_ORDERS_COLLECTION=orders
MONGODB_WEBHOOK_COLLECTION=webhook_events
MONGODB_JOBS_COLLECTION=jobs
MONGODB_DLQ_COLLECTION=dead_letter_jobs

# ─── AI chat ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── PayPal ────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.paypal.com

# ─── Paymob / Fawry / bank webhooks ─────────────────────────────────────────
PAYMOB_WEBHOOK_SECRET=
FAWRY_WEBHOOK_SECRET=
BANK_WEBHOOK_SECRET=
WEBHOOK_SECRET=
WEBHOOK_ALLOW_UNVERIFIED=false

# ─── Checkout rate limiting (optional) ─────────────────────────────────────
CHECKOUT_RATE_LIMIT_MAX=10
CHECKOUT_RATE_LIMIT_WINDOW_MS=600000

# ─── Worker / cron (optional) ──────────────────────────────────────────────
CRON_SECRET=
WORKER_ID=
WORKER_BATCH_SIZE=
WORKER_CONCURRENCY=
WORKER_LEASE_SECONDS=
WORKER_MAX_ATTEMPTS=
WORKER_POLL_INTERVAL_MS=
WORKER_RETRY_BASE_MS=
WORKER_RETRY_MAX_MS=
JOB_BATCH_SIZE=
JOB_LEASE_SECONDS=
MAX_JOB_ATTEMPTS=

# ─── Conversion APIs (optional) ────────────────────────────────────────────
GA_MEASUREMENT_ID=
GA_API_SECRET=
FB_PIXEL_ID=
FB_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
MIXPANEL_TOKEN=

# ─── Customer email automation (optional) ──────────────────────────────────
CUSTOMER_EMAIL_WEBHOOK_URL=
CUSTOMER_EMAIL_API_KEY=

# ─── CRM integrations (optional) ───────────────────────────────────────────
HUBSPOT_API_KEY=
HUBSPOT_PIPELINE=default
HUBSPOT_CLOSED_WON_STAGE=closedwon
HUBSPOT_OWNER_ID=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# ─── Telegram notifications (optional) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Supabase mirror (optional) ────────────────────────────────────────────
# Server-only keys. Do not expose the service role key with NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WEBHOOK_TABLE=webhook_events
