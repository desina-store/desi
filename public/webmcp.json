{
  "webmcpVersion": "1.0.0",
  "storeName": "DeSinaHub",
  "capabilities": {
    "modelCoverage": true,
    "registeredTools": true,
    "validSchemas": true
  },
  "tools": [
    {
      "name": "search_products",
      "description": "البحث في أقسام متجر ديسينا: ملابس، إلكترونيات، برمجيات، خدمات.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyword": { "type": "string" }
        },
        "required": ["keyword"]
      }
    },
    {
      "name": "manage_cart",
      "description": "إدارة وعرض محتويات سلة المشتريات للعميل.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["view", "add"] }
        },
        "required": ["action"]
      }
    },
    {
      "name": "track_order",
      "description": "تتبع حالة طلبات ديسينا عبر الرقم العشوائي أو رقم الطلب.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderId": { "type": "string" }
        },
        "required": ["orderId"]
      }
    }
  ]
}
